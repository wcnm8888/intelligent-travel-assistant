# Local application settings. Copy values into an ignored .env.local file.
# B-000 health checks must work without any third-party API key.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000

# Persistence is not implemented in B-000. Leave empty until a database task defines it.
DATABASE_URL=

# DeepSeek. The key is intentionally empty and must never be committed.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Amap Web Service API key. Account and application have not been created yet.
AMAP_API_KEY=

# QWeather JWT credentials. Keep the Ed25519 PEM outside the repository and reference
# it with an absolute local path; never paste PEM content into this file.
QWEATHER_API_HOST=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY_PATH=
